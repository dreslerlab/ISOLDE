---
import 'modern-normalize/modern-normalize.css';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

interface Props {
  /** Page name, e.g. "Research". Omit on the home page. */
  title?: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const documentTitle = title ? `${title} · ${site.shortName}` : `${site.shortName} · ${site.studyTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={documentTitle} description={description} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
